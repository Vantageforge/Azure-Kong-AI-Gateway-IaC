# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
terraform.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local-only backend config (CI passes -backend-config from repo variables)
backend.hcl

# Saved plans
tfplan
*.tfplan
plan.txt

# Secrets — never commit your Konnect cert/key
certs/*.crt
certs/*.key

# Local kubeconfig exports
*.kubeconfig
kong-demo-config

# decK — rendered/merged output is a build artifact, never source of truth
kong-config/.rendered/

# Local overrides of environment values (real secrets should come from a
# secrets manager / CI secret store, never a committed file)
kong-config/environments/*.local.env
