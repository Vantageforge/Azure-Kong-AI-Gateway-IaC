# ---------------------------------------------------------------------------
# dev environment values.
#
# Sourced by scripts/render.sh / diff.sh / sync.sh before invoking `deck`.
# Every var here fills a ${DECK_*} placeholder in base/**/*.yaml.
#
# Non-secret defaults are safe to commit. Anything sensitive is left as
# "changeme-in-ci" and MUST be overridden by a real secret (CI secret store
# / Key Vault / 1Password, etc.) — never edit it in place here.
# ---------------------------------------------------------------------------

DECK_ENVIRONMENT=dev

# --- Upstreams ---------------------------------------------------------
DECK_HTTPBIN_UPSTREAM_URL=https://httpbin.org
DECK_USERS_API_UPSTREAM_URL=http://users-api.dev.svc.cluster.local:8080
DECK_ORDERS_API_UPSTREAM_URL=http://orders-api.dev.svc.cluster.local:8080

# --- Observability -------------------------------------------------------
# In-cluster Datadog Agent OTLP HTTP receiver (see root README + main.tf's
# datadog helm_release).
DECK_OTEL_TRACES_ENDPOINT=http://datadog.datadog.svc.cluster.local:4318/v1/traces
DECK_MAX_PAYLOAD_SIZE_MB=10

# --- CORS ------------------------------------------------------------------
DECK_CORS_ALLOWED_ORIGIN=*

# --- Rate limits (requests/minute) -----------------------------------------
DECK_USERS_API_PUBLIC_RATE_LIMIT=300
DECK_USERS_API_ADMIN_RATE_LIMIT=60
DECK_ORDERS_API_RATE_LIMIT=200

# --- Credentials (placeholders — override via CI secrets, never commit real values) ---
DECK_ADMIN_CONSOLE_API_KEY=changeme-in-ci
DECK_PARTNER_HMAC_USERNAME=changeme-in-ci
DECK_PARTNER_HMAC_SECRET=changeme-in-ci
