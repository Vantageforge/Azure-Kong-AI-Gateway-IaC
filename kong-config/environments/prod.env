# prod environment values — see dev.env for field-by-field comments.
#
# In a real deployment, every DECK_* value below (not just the credentials)
# would come from CI secrets / a secrets manager rather than sitting in
# git — prod endpoints and origins are templated here too so swapping the
# source of truth later doesn't require touching base/**/*.yaml.

DECK_ENVIRONMENT=prod

DECK_HTTPBIN_UPSTREAM_URL=https://httpbin.org
DECK_USERS_API_UPSTREAM_URL=http://users-api.prod.svc.cluster.local:8080
DECK_ORDERS_API_UPSTREAM_URL=http://orders-api.prod.svc.cluster.local:8080

DECK_OTEL_TRACES_ENDPOINT=http://datadog.datadog.svc.cluster.local:4318/v1/traces
DECK_MAX_PAYLOAD_SIZE_MB=6

DECK_CORS_ALLOWED_ORIGIN=https://app.example.com

DECK_USERS_API_PUBLIC_RATE_LIMIT=120
DECK_USERS_API_ADMIN_RATE_LIMIT=20
DECK_ORDERS_API_RATE_LIMIT=90

DECK_ADMIN_CONSOLE_API_KEY=changeme-in-ci
DECK_PARTNER_HMAC_USERNAME=changeme-in-ci
DECK_PARTNER_HMAC_SECRET=changeme-in-ci
