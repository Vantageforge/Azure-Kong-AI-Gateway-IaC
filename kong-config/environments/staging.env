# staging environment values — see dev.env for field-by-field comments.

DECK_ENVIRONMENT=staging

DECK_HTTPBIN_UPSTREAM_URL=https://httpbin.org
DECK_USERS_API_UPSTREAM_URL=http://users-api.staging.svc.cluster.local:8080
DECK_ORDERS_API_UPSTREAM_URL=http://orders-api.staging.svc.cluster.local:8080

DECK_OTEL_TRACES_ENDPOINT=http://datadog.datadog.svc.cluster.local:4318/v1/traces
DECK_MAX_PAYLOAD_SIZE_MB=10

DECK_CORS_ALLOWED_ORIGIN=https://staging.example.com

DECK_USERS_API_PUBLIC_RATE_LIMIT=180
DECK_USERS_API_ADMIN_RATE_LIMIT=30
DECK_ORDERS_API_RATE_LIMIT=120

DECK_ADMIN_CONSOLE_API_KEY=changeme-in-ci
DECK_PARTNER_HMAC_USERNAME=changeme-in-ci
DECK_PARTNER_HMAC_SECRET=changeme-in-ci
