# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored on purpose — it holds the Datadog API key
# and any environment-specific overrides.

# Datadog Agent settings. datadog_api_key is sensitive — prefer the
# TF_VAR_datadog_api_key env var or a secrets manager over committing it.
datadog_api_key = "<your-datadog-api-key>"
datadog_site    = "datadoghq.com"

# --- Kong data plane -----------------------------------------------------
# The full Helm values tree is assembled in kong-helm-values.tf. The Konnect
# control plane + telemetry endpoints are pinned there; everything else is a
# variable with a default in variables.tf — override here only if needed.
# kong_image_repository   = "kong/kong-gateway"
# kong_image_tag          = "3.15"
# kong_proxy_access_log   = "/dev/stdout"
# kong_proxy_error_log    = "/dev/stderr"
# kong_status_listen      = "0.0.0.0:8100"
# kong_dns_stale_ttl      = "3600"
# kong_resources_requests = { cpu = 1, memory = "2Gi" }

# --- Optional cluster overrides — defaults are set in variables.tf ------
# resource_group_name = "kong-demo-rg"
# location             = "eastus"
# cluster_name         = "kong-demo-aks"
# node_count           = 2
# node_vm_size         = "Standard_D4s_v7"
